# Modesy Supabase Configuration
# Optional: The app works 100% out of the box with offline/local fallback data!
# If you want to connect to your live Supabase project, copy this file to .env.local and fill in the values:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
